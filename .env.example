# =========================================================================
# MetaScale — Exemplo de variáveis de ambiente
# =========================================================================
# COMO USAR:
#   1. Copie este arquivo para .env.local  (cp .env.example .env.local)
#   2. Preencha os valores abaixo com as SUAS chaves
#   3. NUNCA suba o .env.local para o Git (ele já está no .gitignore)
# =========================================================================


# =========================================================================
# 🗄️ SUPABASE (banco de dados)
# =========================================================================
# Onde pegar: painel do Supabase → Project Settings → API
#   - URL do projeto e as chaves anon/service_role ficam nessa página.
#   - Crie um projeto grátis em https://supabase.com se ainda não tiver.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui
# ⚠️ A service_role ignora o RLS — use SOMENTE no servidor. Nunca exponha no client.


# =========================================================================
# 📘 META ADS (Facebook / Instagram)
# =========================================================================
# Onde pegar:
#   - APP_ID e APP_SECRET: https://developers.facebook.com → seu App → Configurações
#   - ACCESS_TOKEN: gere um token com permissões ads_read / ads_management
#     (Graph API Explorer ou um token de longa duração do seu App)
#   - AD_ACCOUNT_ID: no Gerenciador de Anúncios, no formato act_XXXXXXXXXX

META_APP_ID=seu-app-id
META_APP_SECRET=seu-app-secret
META_ACCESS_TOKEN=seu-access-token-da-graph-api
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX


# =========================================================================
# 🧠 ANTHROPIC (IA — diagnósticos e análise profunda)
# =========================================================================
# Onde pegar: https://console.anthropic.com → API Keys
#   - A chave começa com sk-ant-...
#   - Modelo usado no projeto: claude-sonnet-5

ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui


# =========================================================================
# 🐙 GITHUB (opcional — só se for versionar/subir seu próprio fork)
# =========================================================================
# Não é necessário para RODAR o app; só para dar git push no seu repositório.
# Onde pegar o token: GitHub → Settings → Developer settings → Personal access tokens

GITHUB_EMAIL=seu-email@exemplo.com
GITHUB_USERNAME=seu-usuario
GITHUB_TOKEN=ghp_seu-token-aqui
REPOSITORIO=https://github.com/seu-usuario/seu-repo
