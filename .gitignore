# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planning
.planning/codebase

# temp and scratch files
scratch/
analyze_*.py

# prints do dashboard (contêm dados reais de cliente) — versiona só o README
prints/*
!prints/README.md

# análises de IA salvas localmente (dados reais de cliente) — versiona só o README
analises-ia/*
!analises-ia/README.md

# environment variables
.env

# obsidian vault config (o projeto vive dentro de um vault; config local não versiona)
.obsidian/
